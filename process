const comments = [];

function addComment() {
  const ta = document.getElementById('newComment');
  const text = ta.value.trim();
  if (!text) return;
  const now = new Date().toLocaleString('en-GB',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
  comments.push({ text, time: now });
  ta.value = '';
  renderComments();
}

