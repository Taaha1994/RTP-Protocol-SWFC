<title>The Wednesday RTP Protocol</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;1,700;1,800&family=Barlow:wght@400;500;600;700&display=swap">
<style>
/* =============================================
   SWFC NADEEM RTP SCORE — Design tokens
   Colours from Wednesday Way master document
   ============================================= */
:root {
  --swfc-blue:    #1a3a8f;   /* deep royal blue — primary */
  --swfc-blue2:   #2250b5;   /* mid blue */
  --swfc-blue3:   #4780BD;   /* lighter blue accent */
  --swfc-navy:    #0d1e52;   /* darkest navy */
  --swfc-gold:    #E0A92C;
  --swfc-gold2:   #f5c842;
  --bg:           #f0f2f7;
  --surface:      #ffffff;
  --surface2:     #e8ecf5;
  --border:       #c8d4ea;
  --fg:           #0d1e52;
  --fg-mid:       #2a3a6a;
  --fg-muted:     #5a6a90;
  --label:        #1a3a8f;
  --pass:         #0d6e3a;
  --pass-bg:      #e4f5ec;
  --hold:         #b35a00;
  --hold-bg:      #fff0e0;
  --fail:         #a81c1c;
  --fail-bg:      #fdecea;
  --radius:       6px;
  --font-head:    'Barlow Condensed', Impact, 'Arial Narrow', sans-serif;
  --font-body:    'Barlow', system-ui, sans-serif;
}

/* Single-theme: SWFC light doc — deliberate choice */
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--fg);
  font-size: 14px;
  line-height: 1.5;
  padding: 0 0 40px;
}

/* ─── HEADER ─────────────────────────────── */
.swfc-header {
  background: #ffffff;
  padding: 18px 28px 20px;
  display: flex;
  align-items: center;
  gap: 18px;
  border-bottom: 4px solid var(--swfc-gold);
  border-top: 4px solid var(--swfc-blue);
  position: relative;
}

.owl-logo {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
  object-fit: contain;
}

/* SVG owl — traced from SWFC brand */
.header-text {
  flex: 1;
}

.header-eyebrow {
  font-family: var(--font-body);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--fg-muted);
  margin-bottom: 2px;
}

.header-title {
  font-family: var(--font-head);
  font-style: italic;
  font-weight: 800;
  font-size: 2.1rem;
  color: var(--swfc-blue);
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0.01em;
}

.header-sub {
  font-size: 0.75rem;
  color: var(--fg-muted);
  margin-top: 4px;
  font-weight: 400;
}

.season-badge {
  background: var(--swfc-blue);
  color: #fff;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 0.8rem;
  padding: 6px 14px;
  border-radius: 4px;
  white-space: nowrap;
  letter-spacing: 0.03em;
  align-self: flex-start;
  margin-top: 4px;
  flex-shrink: 0;
}

/* ─── BODY ───────────────────────────────── */
.main {
  max-width: 800px;
  margin: 0 auto;
  padding: 24px 20px 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ─── SECTION LABEL (blue italic like doc) ─ */
.section-label {
  font-family: var(--font-head);
  font-style: italic;
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--swfc-blue);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 2px solid var(--swfc-blue3);
  padding-bottom: 5px;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ─── CARDS ──────────────────────────────── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}

.card-head {
  background: var(--swfc-blue);
  padding: 9px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.card-head-gold {
  background: var(--swfc-gold);
}

.card-head h2 {
  font-family: var(--font-head);
  font-style: italic;
  font-weight: 700;
  font-size: 0.95rem;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  flex: 1;
}
.card-head-gold h2 { color: var(--swfc-navy); }

.card-head .domain-pts {
  font-family: var(--font-body);
  font-size: 0.72rem;
  font-weight: 700;
  color: rgba(255,255,255,0.75);
  letter-spacing: 0.04em;
}
.card-head-gold .domain-pts { color: rgba(13,30,82,0.65); }

.card-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* ─── PLAYER INFO GRID ───────────────────── */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
@media (max-width: 520px) { .info-grid { grid-template-columns: 1fr; } }

.field {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.field label {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--label);
}
.field input, .field select, .field textarea {
  font-family: var(--font-body);
  font-size: 0.88rem;
  background: var(--surface2);
  border: 1.5px solid var(--border);
  border-radius: 4px;
  padding: 7px 10px;
  color: var(--fg);
  transition: border-color 0.12s;
  width: 100%;
}
.field input:focus, .field select:focus, .field textarea:focus {
  outline: none;
  border-color: var(--swfc-blue);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(26,58,143,0.1);
}
.field textarea { resize: vertical; min-height: 56px; }

/* ─── SCORE ITEMS ────────────────────────── */
.score-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 12px;
  border-radius: 4px;
  background: var(--surface2);
  border: 1.5px solid transparent;
  cursor: pointer;
  transition: all 0.12s;
  user-select: none;
}
.score-item:hover { border-color: var(--swfc-blue3); background: #eef2fc; }
.score-item.checked {
  background: #dde8f8;
  border-color: var(--swfc-blue);
}
.score-item.penalty:hover { border-color: var(--fail); background: #fbeaea; }
.score-item.penalty.checked {
  background: var(--fail-bg);
  border-color: var(--fail);
}

.score-item input[type="checkbox"] {
  width: 16px; height: 16px;
  accent-color: var(--swfc-blue);
  flex-shrink: 0;
  margin-top: 2px;
  cursor: pointer;
}
.score-item.penalty input[type="checkbox"] { accent-color: var(--fail); }

.item-text { flex: 1; min-width: 0; }
.item-label {
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--fg);
  line-height: 1.35;
}
.item-sub {
  font-size: 0.72rem;
  color: var(--fg-muted);
  margin-top: 1px;
  line-height: 1.4;
}
.item-pts {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--swfc-blue);
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
  min-width: 24px;
  text-align: right;
  padding-top: 2px;
}
.score-item.penalty .item-pts { color: var(--fail); }

/* ─── GATES ──────────────────────────────── */
.gates-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media (max-width: 500px) { .gates-row { grid-template-columns: 1fr; } }

.gate-card {
  background: var(--surface);
  border: 2px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: border-color 0.2s;
}
.gate-card.pass { border-color: var(--pass); }
.gate-card.hold { border-color: var(--hold); }

.gate-head {
  background: var(--swfc-blue);
  padding: 8px 14px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.gate-head-gold { background: var(--swfc-gold); }

.gate-head-title {
  font-family: var(--font-head);
  font-style: italic;
  font-weight: 700;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #fff;
  flex: 1;
}
.gate-head-gold .gate-head-title { color: var(--swfc-navy); }

.gate-body { padding: 14px; }

.gate-num-row {
  display: flex;
  align-items: baseline;
  gap: 3px;
  margin-bottom: 6px;
}
.gate-big-num {
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 2.6rem;
  line-height: 1;
  color: var(--swfc-blue);
  font-variant-numeric: tabular-nums;
}
.gate-big-num.gold { color: var(--swfc-gold); }
.gate-denom {
  font-size: 0.95rem;
  color: var(--fg-muted);
}

.score-bar {
  height: 5px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
  margin: 6px 0 10px;
}
.bar-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.3s ease;
  background: var(--swfc-blue);
}
.bar-fill.pass { background: var(--pass); }
.bar-fill.hold { background: var(--hold); }
.bar-fill.gold { background: var(--swfc-gold); }

.verdict-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 3px;
  font-size: 0.72rem;
  font-weight: 700;
  font-family: var(--font-body);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 8px;
}
.verdict-chip.pass { background: var(--pass-bg); color: var(--pass); }
.verdict-chip.hold { background: var(--hold-bg); color: var(--hold); }
.verdict-chip.neutral { background: var(--surface2); color: var(--fg-muted); }

.gate-thresh {
  font-size: 0.7rem;
  color: var(--fg-muted);
  line-height: 1.5;
}
.gate-thresh strong { color: var(--fg-mid); }

/* ─── SUMMARY PANEL ──────────────────────── */
.summary-panel {
  background: var(--swfc-navy);
  border-radius: var(--radius);
  overflow: hidden;
}
.summary-panel-head {
  background: var(--swfc-blue);
  padding: 10px 18px;
  border-bottom: 3px solid var(--swfc-gold);
  display: flex;
  align-items: center;
  gap: 10px;
}
.summary-panel-head h2 {
  font-family: var(--font-head);
  font-style: italic;
  font-weight: 800;
  font-size: 1.1rem;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  flex: 1;
}
.summary-panel-body {
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.sum-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}
@media (max-width: 500px) { .sum-grid { grid-template-columns: 1fr 1fr; } }

.sum-cell {
  background: rgba(255,255,255,0.07);
  border-radius: 4px;
  padding: 8px 10px;
}
.sum-cell-label {
  font-size: 0.64rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: rgba(255,255,255,0.45);
  margin-bottom: 3px;
}
.sum-cell-val {
  font-size: 0.88rem;
  font-weight: 600;
  color: #fff;
}

.sum-verdicts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
@media (max-width: 400px) { .sum-verdicts { grid-template-columns: 1fr; } }

.sum-verdict {
  border-radius: 4px;
  padding: 12px 14px;
  text-align: center;
  border: 1.5px solid transparent;
}
.sum-verdict.pass { background: var(--pass-bg); border-color: var(--pass); }
.sum-verdict.hold { background: var(--hold-bg); border-color: var(--hold); }
.sum-verdict-label {
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 4px;
}
.sum-verdict.pass .sum-verdict-label { color: var(--pass); }
.sum-verdict.hold .sum-verdict-label { color: var(--hold); }
.sum-verdict-val {
  font-size: 0.9rem;
  font-weight: 700;
}
.sum-verdict.pass .sum-verdict-val { color: var(--pass); }
.sum-verdict.hold .sum-verdict-val { color: var(--hold); }

.notes-block {
  background: rgba(255,255,255,0.06);
  border-radius: 4px;
  padding: 10px 12px;
}
.notes-block label {
  display: block;
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: rgba(255,255,255,0.4);
  margin-bottom: 6px;
}
.notes-block textarea {
  width: 100%;
  font-family: var(--font-body);
  font-size: 0.84rem;
  background: transparent;
  border: none;
  color: rgba(255,255,255,0.85);
  resize: vertical;
  min-height: 50px;
  line-height: 1.5;
}
.notes-block textarea:focus { outline: none; }
.notes-block textarea::placeholder { color: rgba(255,255,255,0.22); }

/* ─── BUTTONS ────────────────────────────── */
.btn-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 8px 16px;
  border-radius: 4px;
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
  border: none;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  transition: all 0.12s;
}
.btn-blue { background: var(--swfc-blue); color: #fff; }
.btn-blue:hover { background: var(--swfc-blue2); }
.btn-gold { background: var(--swfc-gold); color: var(--swfc-navy); }
.btn-gold:hover { background: var(--swfc-gold2); }
.btn-ghost {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.7);
  border: 1px solid rgba(255,255,255,0.15);
}
.btn-ghost:hover { background: rgba(255,255,255,0.14); color: #fff; }

/* ─── FOOTER ─────────────────────────────── */
.swfc-footer {
  max-width: 800px;
  margin: 16px auto 0;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6px;
  border-top: 1.5px solid var(--border);
  padding-top: 14px;
}
.footer-brand {
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--swfc-blue);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.footer-meta {
  font-size: 0.68rem;
  color: var(--fg-muted);
  text-align: right;
}

.evidence-note {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 16px;
  font-size: 0.71rem;
  color: var(--fg-muted);
  line-height: 1.6;
}
.evidence-note strong { color: var(--fg-mid); }

/* ─── MISC ───────────────────────────────── */
.no-print { }

@media print {
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  .no-print { display: none !important; }
  body { background: #fff !important; padding: 0; font-size: 11px; }
  .main { max-width: 100%; padding: 12px 16px 0; gap: 10px; }
  .swfc-header { padding: 12px 16px; border-top: 3px solid var(--swfc-blue); }
  .owl-logo { width: 44px; height: 44px; }
  .header-title { font-size: 1.5rem; }
  .season-badge { font-size: 0.7rem; padding: 4px 10px; }
  .card { break-inside: avoid; }
  .card-body { padding: 10px 12px; gap: 5px; }
  .score-item { padding: 6px 10px; }
  .item-label { font-size: 0.78rem; }
  .item-sub { font-size: 0.65rem; }
  .gates-row { gap: 10px; }
  .gate-body { padding: 10px; }
  .gate-big-num { font-size: 2rem; }
  .summary-panel { break-inside: avoid; }
  .summary-panel-body { padding: 12px; gap: 10px; }
  .sum-cell-val { font-size: 0.8rem; }
  .notes-block textarea { min-height: 60px; color: #000 !important; }
  .evidence-note { font-size: 0.65rem; padding: 8px 12px; }
  .swfc-footer { margin-top: 10px; padding-top: 8px; }
  /* Print header — show URL for reference */
  .print-url { display: block !important; }
}
</style>

<!-- ═══ HEADER ═══════════════════════════════════════════════════════ -->
<header class="swfc-header">
  <img class="owl-logo" src="data:image/jpeg;base64," alt="Sheffield Wednesday FC" />

  <div class="header-text">
    <div class="header-eyebrow">Sheffield Wednesday FC · First Team Medical &amp; Performance</div>
    <div class="header-title">The Wednesday RTP Protocol</div>
    <div class="header-sub">Return to Play · Evidence-Based Assessment · v3.0</div>
  </div>
  <div class="season-badge">Season 26/27</div>
</header>

<!-- ═══ MAIN ══════════════════════════════════════════════════════════ -->
<div class="main">

  <!-- PLAYER INFO -->
  <div class="card">
    <div class="card-head">
      <h2>Player Information</h2>
    </div>
    <div class="card-body">
      <div class="info-grid">
        <div class="field">
          <label>Player Name</label>
          <input type="text" id="playerName" placeholder="Full name" />
        </div>
        <div class="field">
          <label>Injury Category <span style="font-weight:400;color:var(--fg-muted)">(adapts clinical guidance below)</span></label>
          <select id="injuryCategory" onchange="applyInjuryProfile()" style="width:100%;padding:8px 10px;border:1.5px solid var(--border);border-radius:var(--radius);font-family:var(--font-body);font-size:13px;background:var(--surface);color:var(--fg);">
            <option value="hamstring">Hamstring</option>
            <option value="quad">Quadriceps</option>
            <option value="achilles">Calf / Achilles Tendon</option>
            <option value="groin">Groin / Hip Flexor / Adductor</option>
            <option value="calf_muscle">Calf (Gastrocnemius / Soleus)</option>
            <option value="other">Other Muscle / Tendon</option>
          </select>
        </div>
        <div class="field">
          <label>Injury Detail / Grade</label>
          <input type="text" id="injuryType" placeholder="e.g. Right hamstring Grade 2b (Munich)" />
        </div>
        <div class="field">
          <label>Date of Injury</label>
          <input type="date" id="injuryDate" />
        </div>
        <div class="field">
          <label>Assessment Date</label>
          <input type="date" id="assessDate" />
        </div>
        <div class="field">
          <label>Days Since Injury</label>
          <input type="number" id="daysSince" placeholder="0" min="0" />
        </div>
        <div class="field">
          <label>Assessing Clinician</label>
          <input type="text" id="clinician" placeholder="Name and role" />
        </div>
        <div class="field">
          <label>Individual Physio Sessions Completed</label>
          <input type="number" id="physioSessions" placeholder="0" min="0" />
        </div>
        <div class="field">
          <label>Team Training Sessions Completed</label>
          <input type="number" id="teamSessions" placeholder="0" min="0" />
        </div>
      </div>
    </div>
  </div>

  <!-- GATE 1 HEADING -->
  <div class="section-label">Gate 1 — Return to Training <span style="font-size:0.7rem;font-style:normal;font-weight:500;color:var(--fg-muted);text-transform:none;letter-spacing:0">· Domains 1–4 · Max 13 pts · Threshold ≥ 11</span></div>

  <!-- DOMAIN 1 -->
  <div class="card">
    <div class="card-head">
      <h2>Domain 1 · Clinical &amp; Symptoms</h2>
      <span class="domain-pts" id="d1score">0 / 4</span>
    </div>
    <div class="card-body">
      <label class="score-item" data-domain="1" data-pts="1">
        <input type="checkbox" />
        <div class="item-text">
          <div class="item-label">Pain-free at rest and during normal activity</div>
          <div class="item-sub">VAS 0/10 at rest; no spontaneous pain with ADL</div>
        </div>
        <div class="item-pts">+1</div>
      </label>
      <label class="score-item" data-domain="1" data-pts="1">
        <input type="checkbox" />
        <div class="item-text">
          <div class="item-label">Full pain-free palpation at injury site</div>
          <div class="item-sub" id="d1-palpation">No tenderness on direct palpation of affected structure. Absence of palpation tenderness is the only clinical finding independently associated with re-injury outcome (AOR 3.95, van der Horst 2017)</div>
        </div>
        <div class="item-pts">+1</div>
      </label>
      <label class="score-item" data-domain="1" data-pts="1">
        <input type="checkbox" />
        <div class="item-text">
          <div class="item-label">Full pain-free range of motion</div>
          <div class="item-sub" id="d1-rom">Active and passive ROM equal to contralateral side; no end-range pain or stretch discomfort</div>
        </div>
        <div class="item-pts">+1</div>
      </label>
      <label class="score-item" data-domain="1" data-pts="1" id="d1-item3">
        <input type="checkbox" />
        <div class="item-text">
          <div class="item-label" id="d1-item3-label">No oedema, haematoma, or protective muscle spasm</div>
          <div class="item-sub" id="d1-item3-sub">Local swelling resolved; no guarding on examination; normal tissue texture on palpation</div>
        </div>
        <div class="item-pts">+1</div>
      </label>
      <label class="score-item penalty" data-domain="1" data-pts="-1" data-penalty="true">
        <input type="checkbox" />
        <div class="item-text">
          <div class="item-label">⚠ Previous injury to same anatomical area</div>
          <div class="item-sub">Any prior injury same structure / same side — strongest predictor of re-injury (van der Horst 2021)</div>
        </div>
