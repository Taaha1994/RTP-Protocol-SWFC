function toggleIkd() {
  const panel = document.getElementById('ikdPanel');
  const chevron = document.getElementById('ikdChevron');
  const open = panel.style.display === 'none';
  panel.style.display = open ? 'block' : 'none';
  chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
}

function onIkdPerformedChange() {
  const performed = document.getElementById('ikdPerformed').checked;
  const content = document.getElementById('ikdContent');
  const badge = document.getElementById('ikdStatusBadge');
  content.style.display = performed ? 'block' : 'none';
  if (!performed) {
    // Reset everything when unchecked
    document.querySelectorAll('.ikd-validity').forEach(cb => cb.checked = false);
    ['ikdAffected','ikdUnaffected','ikdHQ'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    document.getElementById('ikdCalcResult').innerHTML = '';
    document.getElementById('ikdContralateralWarn').style.display = 'none';
    document.getElementById('ikdResultsSection').style.display = 'none';
    updateIkdValidity();
    badge.textContent = 'NOT PERFORMED';
    badge.style.background = '#e8ecf5';
    badge.style.color = 'var(--fg-muted)';
  } else {
    badge.textContent = 'PERFORMED — CHECK VALIDITY';
    badge.style.background = '#fff3cd';
    badge.style.color = '#856404';
    updateIkdValidity();
  }
}

function updateIkdValidity() {
  const checkboxes = document.querySelectorAll('.ikd-validity');
  const checked = Array.from(checkboxes).filter(cb => cb.checked).length;
  const total = checkboxes.length;
  const countEl = document.getElementById('ikdValidityCount');
  const verdictEl = document.getElementById('ikdValidityVerdict');
  const resultsEl = document.getElementById('ikdResultsSection');
  const badge = document.getElementById('ikdStatusBadge');
  const performed = document.getElementById('ikdPerformed').checked;

  if (countEl) countEl.textContent = checked + ' / ' + total + ' criteria met';

  if (!performed) return;

  if (checked >= 4) {
    if (verdictEl) {
      verdictEl.textContent = '✓ Session valid (' + checked + '/' + total + ') — results interpretable';
      verdictEl.style.color = 'var(--pass)';
      verdictEl.style.background = 'var(--pass-bg)';
      verdictEl.style.borderColor = 'var(--pass)';
    }
    if (resultsEl) resultsEl.style.display = 'block';
    badge.textContent = 'VALID — ' + checked + '/' + total;
    badge.style.background = 'var(--pass-bg)';
    badge.style.color = 'var(--pass)';
  } else if (checked >= 2) {
    if (verdictEl) {
      verdictEl.textContent = '⚠ Insufficient validity (' + checked + '/' + total + ') — results cannot gate Domain 2';
      verdictEl.style.color = 'var(--hold)';
      verdictEl.style.background = 'var(--hold-bg)';
      verdictEl.style.borderColor = 'var(--hold)';
    }
    if (resultsEl) resultsEl.style.display = 'none';
    badge.textContent = 'INVALID — ' + checked + '/' + total;
    badge.style.background = 'var(--hold-bg)';
    badge.style.color = 'var(--hold)';
  } else {
    if (verdictEl) {
      verdictEl.textContent = '✗ Session invalid (' + checked + '/' + total + ') — discard results';
      verdictEl.style.color = 'var(--fail)';
      verdictEl.style.background = 'var(--fail-bg)';
      verdictEl.style.borderColor = 'var(--fail)';
    }
    if (resultsEl) resultsEl.style.display = 'none';
    badge.textContent = 'INVALID — ' + checked + '/' + total;
    badge.style.background = 'var(--fail-bg)';
    badge.style.color = 'var(--fail)';
  }
}

function calcIkdLsi() {
  const affected = parseFloat(document.getElementById('ikdAffected').value);
  const unaffected = parseFloat(document.getElementById('ikdUnaffected').value);
  const hq = parseFloat(document.getElementById('ikdHQ').value);
  const resultEl = document.getElementById('ikdCalcResult');
  const warnEl = document.getElementById('ikdContralateralWarn');

  if (!resultEl) return;

  if (isNaN(affected) || isNaN(unaffected) || unaffected <= 0) {
    resultEl.innerHTML = '';
    resultEl.style.display = 'none';
    return;
  }

  const lsi = (affected / unaffected) * 100;
  let colour, label, advice;

  if (lsi >= 90) {
    colour = 'var(--pass)'; label = '✓ LSI ' + lsi.toFixed(1) + '%';
    advice = 'Within RTP threshold (≥90%). Supports Domain 2 item 1 if clinical assessment also passes.';
  } else if (lsi >= 85) {
    colour = 'var(--hold)'; label = '⚠ LSI ' + lsi.toFixed(1) + '%';
    advice = 'Borderline deficit (85–89%). Review clinical picture carefully. Strength deficit may limit RTP.';
  } else {
    colour = 'var(--fail)'; label = '✗ LSI ' + lsi.toFixed(1) + '%';
    advice = 'Significant deficit (<85%). Domain 2 item 1 should NOT be ticked regardless of clinical impression. Hold recommended.';
  }

  let hqHtml = '';
  if (!isNaN(hq)) {
    const hqStatus = hq >= 60
      ? '<span style="color:var(--pass)">✓ H:Q ' + hq + '% (≥60% conventional threshold)</span>'
      : '<span style="color:var(--fail)">✗ H:Q ' + hq + '% — below 60°/s threshold of 60%. Imbalance present.</span>';
    hqHtml = '<div style="margin-top:6px;font-size:12px;">' + hqStatus + '</div>';
  }

  resultEl.style.display = 'block';
  resultEl.innerHTML =
    '<div style="font-weight:700;color:' + colour + ';font-size:13px;">' + label + '</div>' +
    '<div style="font-size:12px;color:var(--fg-mid);margin-top:3px;">' + advice + '</div>' +
    hqHtml;

  // Check for contralateral limb drop (session confound flag)
  // If unaffected side is ≥10% below what would be expected — we check if HHD LSI from elsewhere entered
  // Practical proxy: if user enters both limbs and affected > unaffected (paradox), flag
  if (affected > unaffected * 1.05) {
    warnEl.style.display = 'block';
  } else {
    warnEl.style.display = 'none';
  }
}

function applyInjuryProfile() {
  const cat = document.getElementById('injuryCategory').value;
  const profile = injuryProfiles[cat] || injuryProfiles.other;
  Object.entries(profile).forEach(([id, text]) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  });
}

